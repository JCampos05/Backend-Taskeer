// Taskeer — esquema de base de datos (MySQL vía Prisma)
//
// Decisiones de diseño (ver planeación en el chat):
// - IDs públicos como UUID en vez de enteros autoincrementales, para evitar
//   enumeración de recursos. Prisma genera UUID v4 por defecto con @default(uuid());
//   para producción se recomienda sustituirlo por UUID v7 (time-ordered, mejor para
//   índices B-tree en MySQL) generado en la capa de servicio con el paquete `uuidv7`
//   y pasado explícitamente al crear el registro, en vez de depender del default.
// - Slugs en Workspace y Board para URLs amigables/compartibles; nunca se usan
//   como FK interna, solo como identificador público adicional.
// - Soft delete (`deletedAt`) en Workspace/Board/Task para recuperación y para
//   poder cumplir borrado real diferido (retención + purga) sin perder auditoría.
// - AuditLog para eventos de seguridad (login, cambios de rol, borrados), separado
//   de los logs de aplicación.
// - Índices pensados para las consultas más frecuentes: pertenencia a workspace,
//   orden del kanban (position), y el polling de recordatorios pendientes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
}

enum SyncMutationStatus {
  APPLIED
  CONFLICT
  REJECTED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum InterfaceTheme {
  LIGHT
  DARK
  AUTO
}

model UserPreferences {
  id         String         @id @default(uuid()) @db.Char(36)
  userId     String         @unique @db.Char(36)
  countryId  Int?
  timezoneId Int?
  // AUTO sigue la configuración del sistema operativo/navegador del usuario.
  theme      InterfaceTheme @default(AUTO)
  // ISO 639-1. Placeholder para cuando Taskeer soporte más de un idioma de interfaz.
  language   String         @default("es") @db.Char(2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  country  Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  timezone Timezone? @relation(fields: [timezoneId], references: [id], onDelete: SetNull)

  @@map("user_preferences")
}

enum InvitationStatus {
  PENDING
  // El invitado ya aceptó, pero todavía no es miembro: un OWNER/ADMIN del
  // workspace debe confirmar que la persona que aceptó es quien se esperaba
  // (cierra el caso de alguien que se registra con el correo invitado antes
  // que el invitado real). `expiresAt` pasa a ser el plazo de esa aprobación.
  AWAITING_APPROVAL
  ACCEPTED
  EXPIRED
  REVOKED
}

// Catálogo estático (205 países, tomado de un dataset ISO 3166-1 alpha-2 existente).
// Entero autoincremental a propósito, no UUID: es un catálogo de referencia público,
// no hay nada sensible que enumerar.
model Country {
  id        Int      @id @default(autoincrement())
  isoCode   String   @unique @db.Char(2)
  name      String   @db.VarChar(100)
  flagEmoji String?  @db.VarChar(16)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences UserPreferences[]

  @@index([isoCode])
  @@map("countries")
}

// Catálogo estático (24 zonas horarias con offset fijo). El id es manual y curado
// (no autoincrement) porque el origen (data.sql) lo trae así — se preserva tal cual.
model Timezone {
  id          Int      @id
  ianaName    String   @unique @db.VarChar(50)
  utcOffset   Decimal  @db.Decimal(3, 1)
  displayName String   @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  preferences UserPreferences[]

  @@index([ianaName])
  @@map("timezones")
}

model User {
  id               String    @id @default(uuid()) @db.Char(36)
  email            String    @unique @db.VarChar(255)
  // Opcional a propósito: una cuenta que solo entra por Google (OAuthIdentity)
  // nunca tiene contraseña propia. Si es null, el login local por
  // email+contraseña debe rechazarse explícitamente, no fallar por un hash
  // vacío comparado a ciegas.
  passwordHash     String?   @db.VarChar(255)
  displayName      String    @db.VarChar(100)
  emailVerifiedAt  DateTime?
  // Cuenta "confiable para invitar": demostró tener uno de sus códigos de
  // recuperación (POST /auth/verify-with-recovery-code). NO prueba que el
  // correo sea suyo, por eso es un campo APARTE de emailVerifiedAt: este
  // último es la única barrera contra el secuestro de cuenta al vincular
  // Google (auth.service.ts, loginWithGoogle) y solo lo pone una prueba real
  // de propiedad del correo (enlace o Google). inviteVerifiedAt solo habilita
  // invitar a workspaces; nunca debe usarse para vincular identidades.
  inviteVerifiedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships        WorkspaceMember[]
  assignedTasks      Task[]                @relation("TaskAssignee")
  assignedSubtasks   Subtask[]             @relation("SubtaskAssignee")
  boardRoleOverrides BoardMemberOverride[]
  pushSubscriptions  PushSubscription[]
  auditLogs          AuditLog[]
  authTokens         AuthToken[]
  recoveryCodes      RecoveryCode[]
  refreshTokens      RefreshToken[]
  sentInvitations    Invitation[]          @relation("InvitationsSent")
  notifications      Notification[]
  preferences        UserPreferences?
  subscription       Subscription?
  oauthIdentities    OAuthIdentity[]
  attachments        Attachment[]
  myDayTasks         MyDayTask[]
  syncMutations      SyncMutation[]

  @@map("users")
}

enum OAuthProvider {
  GOOGLE
}

// Identidad de un proveedor externo vinculada a un User. Separado de User en
// vez de un simple `googleId` en la tabla, para no rehacer el schema si mañana
// se agrega otro proveedor (Apple, GitHub, etc.) — agregar uno nuevo es una
// fila más en este enum, no una columna nueva en User.
model OAuthIdentity {
  id             String        @id @default(uuid()) @db.Char(36)
  userId         String        @db.Char(36)
  provider       OAuthProvider
  // El "sub" que entrega el proveedor (vía Supabase Auth) — estable aunque el
  // usuario cambie su email en Google, a diferencia de guardar el email como
  // identificador.
  providerUserId String        @db.VarChar(255)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Un mismo (provider, providerUserId) nunca puede pertenecer a dos User
  // distintos — es la identidad real de la persona en ese proveedor.
  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

enum NotificationType {
  REMINDER
  INVITATION
  ROLE_CHANGED
  MENTION
  // Se usó uno de los 10 códigos de recuperación de la cuenta — ver
  // "Recuperación de contraseña" en docs/03-autenticacion-seguridad.md.
  // Aviso al dueño; no bloquea el reset, se dispara después.
  RECOVERY_CODE_USED
  // Alguien te asignó una tarea a ti (nunca se dispara si te la asignas a
  // ti mismo — ver tasks.service.ts, createTask/updateTask).
  TASK_ASSIGNED
  // Alguien aceptó una invitación y espera que un OWNER/ADMIN la apruebe —
  // va a todos los OWNER/ADMIN del workspace.
  INVITATION_REQUEST
  // Resultado de esa aprobación (aprobada o rechazada) — va a quien aceptó.
  INVITATION_DECISION
}

model Notification {
  id        String           @id @default(uuid()) @db.Char(36)
  userId    String           @db.Char(36)
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String?          @db.VarChar(500)
  taskId    String?          @db.Char(36)
  // null = no leída. El "centro de notificaciones" del frontend filtra por esto.
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Consulta típica al abrir la app: notificaciones no leídas de este usuario, más recientes primero.
  @@index([userId, readAt])
  @@map("notifications")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  // Igual que AuthToken: se guarda el hash, nunca el token en texto plano.
  tokenHash String    @unique @db.Char(64)
  userAgent String?   @db.VarChar(255)
  ipAddress String?   @db.VarChar(45)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Permite listar "sesiones activas" de un usuario y revocarlas todas de un
  // golpe al hacer reset de contraseña o "cerrar sesión en todos los dispositivos".
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Char(36)
  userId    String        @db.Char(36)
  type      AuthTokenType
  // Nunca se guarda el token en texto plano: se hashea (SHA-256) igual que una
  // contraseña de un solo uso. Si la base de datos se filtra, los enlaces de
  // verificación/reset ya emitidos siguen siendo inutilizables.
  tokenHash String        @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Consulta típica al validar un enlace: por hash exacto, filtrando ya usados/expirados.
  // NOTA: el tipo PASSWORD_RESET queda sin usar activamente desde que el reset de
  // contraseña se resolvió con RecoveryCode (no depende de correo). Se conserva el
  // enum por si en el futuro se agrega un canal por correo como alternativa adicional
  // — no lo elimines ni lo reutilices para otra cosa sin revisar docs/03-autenticacion-seguridad.md.
  @@index([userId, type])
  @@map("auth_tokens")
}

// Códigos de recuperación de un solo uso — el método real de "olvidé mi
// contraseña" de Taskeer, sin depender de correo ni de ningún servicio externo.
// Ver "Recuperación de contraseña" en docs/03-autenticacion-seguridad.md para
// el flujo completo (generación, consumo, regeneración, notificación de uso).
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  // Igual que el resto de tokens: solo se guarda el hash, nunca el código en
  // texto plano. El código en sí solo existe en pantalla una vez, al generarse.
  codeHash  String    @unique @db.Char(64)
  // null = no usado todavía. Nunca se borra la fila al usarse — se marca, para
  // poder auditar cuál de los 10 códigos se consumió y cuándo.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Consulta típica: códigos sin usar de un usuario, para saber cuántos le quedan.
  @@index([userId, usedAt])
  @@map("recovery_codes")
}

enum AttachmentScope {
  PERSONAL
  WORKSPACE
}

// Metadatos de un archivo — el archivo en sí (los bytes) vive en Supabase
// Storage, nunca en MySQL. Esta fila es lo que permite calcular cuánto
// espacio ha usado alguien (contra su cuota de plan) sin tener que preguntarle
// a Supabase cada vez, y lo que sobrevive si algún día se cambia de proveedor
// de storage — solo cambiaría cómo se interpreta `storageKey`.
model Attachment {
  id          String          @id @default(uuid()) @db.Char(36)
  uploaderId  String          @db.Char(36)
  // PERSONAL = cuenta contra la cuota personal del uploader, solo él lo ve.
  // WORKSPACE = cuenta contra la cuota del OWNER del workspace, ver
  // "Quién manda en un workspace compartido" en 08-planes-suscripciones.md.
  scope       AttachmentScope
  workspaceId String?         @db.Char(36)
  taskId      String?         @db.Char(36)
  // Ruta/key dentro del bucket de Supabase Storage. Nunca se guarda el
  // archivo ni su contenido en esta base de datos.
  storageKey  String          @db.VarChar(500)
  fileName    String          @db.VarChar(255)
  mimeType    String          @db.VarChar(150)
  sizeBytes   Int
  createdAt   DateTime        @default(now())
  deletedAt   DateTime?

  uploader  User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Consulta típica: sumar sizeBytes de un uploader (o de un workspace) sin
  // borrar, para comparar contra la cuota del plan antes de aceptar una subida nueva.
  @@index([uploaderId, scope, deletedAt])
  @@index([workspaceId, deletedAt])
  @@map("attachments")
}

model Workspace {
  id        String    @id @default(uuid()) @db.Char(36)
  name      String    @db.VarChar(150)
  slug      String    @unique @db.VarChar(160)
  ownerId   String    @db.Char(36)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  // Workspace "Personal" que cada usuario recibe al registrarse (único por
  // usuario, solo él es miembro). Aloja sus tableros propios y las listas
  // planas / bandeja de la app móvil (Board.isList). No cuenta contra el
  // límite de workspaces del plan y no se puede borrar, transferir ni invitar
  // a otras personas.
  isPersonal  Boolean   @default(false)

  members     WorkspaceMember[]
  boards      Board[]
  invitations Invitation[]
  attachments Attachment[]

  @@index([ownerId])
  @@map("workspaces")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Char(36)
  workspaceId String           @db.Char(36)
  // El invitado puede no tener cuenta todavía — se invita por correo, no por userId.
  email       String           @db.VarChar(255)
  role        WorkspaceRole    @default(EDITOR)
  // Mismo patrón que AuthToken: solo se guarda el hash del token de la invitación.
  tokenHash   String           @unique @db.Char(64)
  invitedById String           @db.Char(36)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  // Para la sincronización: el estado cambia (aprobada, revocada...) sin
  // borrar la fila, así que `updatedAt` es lo que permite pedir "qué cambió".
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  // Consulta típica: invitaciones pendientes de un workspace, o buscar por correo
  // al momento en que alguien se registra con un correo que tiene invitaciones esperando.
  @@index([workspaceId, status])
  @@index([email])
  @@index([updatedAt])
  @@map("invitations")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Char(36)
  workspaceId String        @db.Char(36)
  userId      String        @db.Char(36)
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now())
  // Para la sincronización: un cambio de rol modifica la fila sin crear otra.
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Evita membresías duplicadas y resuelve "¿pertenece este usuario a este
  // workspace?" en un solo lookup indexado — se consulta en cada request autenticado.
  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([updatedAt])
  @@map("workspace_members")
}

model Board {
  id          String    @id @default(uuid()) @db.Char(36)
  workspaceId String    @db.Char(36)
  name        String    @db.VarChar(150)
  slug        String    @db.VarChar(160)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  // Lista plana de la app móvil (incluida la bandeja "Tareas"): un tablero
  // OCULTO de una sola columna dentro del workspace personal. No aparece en
  // los listados de tableros de la web y solo se gestiona por /lists, nunca
  // por los endpoints de tableros/columnas. `listPosition` ordena las listas.
  isList       Boolean  @default(false)
  listPosition Int      @default(0)

  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns         Column[]
  memberOverrides BoardMemberOverride[]

  // El slug es único dentro de su workspace, no globalmente — permite URLs
  // tipo /w/mi-equipo/b/sprint-actual sin coordinar slugs entre workspaces distintos.
  @@unique([workspaceId, slug])
  @@index([workspaceId])
  // Listado y orden de listas planas (y, con isList = false, de tableros
  // normales) de un workspace.
  @@index([workspaceId, isList, listPosition])
  @@index([updatedAt])
  @@map("boards")
}

// Rol efectivo de un miembro del workspace DENTRO de un board puntual —
// reemplaza (no combina) su WorkspaceMember.role mientras exista esta fila,
// en ambas direcciones (puede subir o bajar el rol efectivo, confirmado con
// el usuario) y para TODO lo que ese rol habilita en ese board — incluida
// la gestión de columnas, hoy normalmente exclusiva de OWNER/ADMIN del
// workspace (de facto, un override a OWNER/ADMIN acá crea un "admin de
// tablero" para ESE board puntual — decisión explícita del usuario, no un
// efecto secundario no buscado).
//
// Solo lo puede crear/editar/borrar el OWNER/ADMIN del *workspace* (nunca
// un "admin de tablero" vía su propio override — ver
// boards.service.ts::requireOwnerOrAdmin, que para gestionar overrides usa
// siempre el rol de WorkspaceMember crudo, nunca el rol efectivo).
model BoardMemberOverride {
  id        String        @id @default(uuid()) @db.Char(36)
  boardId   String        @db.Char(36)
  userId    String        @db.Char(36)
  role      WorkspaceRole
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_member_overrides")
}

model Column {
  id           String   @id @default(uuid()) @db.Char(36)
  boardId      String   @db.Char(36)
  name         String   @db.VarChar(100)
  position     Int
  // Límite de tareas simultáneas (no borradas) en esta columna — null =
  // ilimitado. Configurable por OWNER/ADMIN del workspace, igual que el
  // resto de columna/board (docs/07-alcance-mvp.md, "Kanban").
  wipLimit     Int?
  // Marca estructural de "esta columna representa tarea terminada" — antes
  // de este campo no existía NINGUNA señal de completitud en el modelo de
  // datos, solo la convención de nombre "Hecho" que siembra el seed
  // (boards.service.ts, DEFAULT_COLUMN_NAMES), rompible con solo renombrar
  // o agregar una columna después. Usado por "Mi día" (modules/tasks,
  // modules/my-day) para no mostrar como pendiente una tarea ya terminada.
  // Un board puede tener más de una columna marcada (ej. "Hecho" y
  // "Archivado") — configurable por OWNER/ADMIN al crear/editar la columna,
  // igual que wipLimit. Nombre con prefijo is+Column (no solo "isDone") a
  // propósito: distingue "esta es la columna de terminadas" de un futuro
  // Task.isDone que signifique otra cosa ("esta tarea puntual ya se hizo").
  isDoneColumn Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Soft delete (tombstone): un dispositivo que sincroniza tarde necesita saber
  // que la columna se borró; con borrado físico no queda rastro y el dato
  // "resucita" desde el otro dispositivo. Toda lectura filtra deletedAt: null.
  deletedAt    DateTime?

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, position])
  @@index([updatedAt])
  @@map("columns")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(uuid()) @db.Char(36)
  columnId    String       @db.Char(36)
  assigneeId  String?      @db.Char(36)
  title       String       @db.VarChar(200)
  description String?      @db.Text
  dueAt       DateTime?
  // Reintroducido de una versión alpha anterior de Taskeer — reemplaza la
  // idea de swimlanes que se había planteado (el usuario prefirió esto).
  priority    TaskPriority @default(MEDIUM)
  position    Int
  // Instante (UTC) en que se completó la tarea, fijado por el CLIENTE (así
  // funciona sin conexión). Independiente de la columna: Column.isDoneColumn
  // sigue siendo un atajo de UI, pero completar y mover son operaciones
  // distintas. null = no completada.
  completedAt DateTime?
  // Regla de repetición, guardada TAL CUAL: el backend NO calcula recurrencias
  // ni crea la tarea siguiente — lo hace la app al completar (la sucesora llega
  // como una tarea normal con su propio id, idempotente por el `id` de
  // cliente). Guardar la regla permite que otro dispositivo repita la tarea.
  // repeatUnit: DAY | WEEK | MONTH | YEAR (null = no se repite). String y no
  // enum a propósito: un enum de Prisma es un ENUM de MySQL, y añadir un valor
  // exigiría un ALTER de tabla; el conjunto cerrado se valida con Zod en la
  // API (REPEAT_UNITS en tasks.schema.ts).
  repeatUnit        String? @db.VarChar(10)
  // Cada cuántas unidades (>= 1). Obligatorio si hay repeatUnit.
  repeatInterval    Int?
  // Máscara de bits de días de la semana, lunes = bit 0 ... domingo = bit 6;
  // solo con WEEK. null o 0 = el mismo día de la semana que la fecha límite.
  repeatWeekdays    Int?
  // Día del mes que MONTH/YEAR intentan respetar (evita arrastrar un recorte
  // 31 -> 28). Solo con MONTH o YEAR.
  repeatAnchorDay   Int?
  // Id de la tarea siguiente ya creada por la app. Sin FK a propósito: es un
  // dato del cliente y la sucesora puede llegar después (sincronización).
  repeatSuccessorId String? @db.Char(36)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  column        Column         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  // Si se borra el usuario asignado, la tarea sobrevive sin asignar en vez de
  // desaparecer o bloquear el borrado del usuario.
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reminders     Reminder[]
  notifications Notification[]
  attachments   Attachment[]
  subtasks      Subtask[]
  myDayFlags    MyDayTask[]

  @@index([columnId, position])
  @@index([assigneeId])
  @@index([dueAt])
  @@index([updatedAt])
  @@map("tasks")
}

// Marca personal, puesta por el propio dueño de la cuenta (no por otro
// miembro del workspace), de "quiero ver/trabajar esta tarea en Mi día".
// Independiente de si la tarea está asignada a este usuario o no — solo
// requiere que tenga acceso a ella (se valida en el service, igual que
// cualquier otra lectura de Task). Deliberadamente sin su propio "leído":
// a diferencia de Notification (evento puntual), esto es un estado
// on/off que el usuario prende y apaga él mismo — quitarla de Mi día es un
// soft delete (`deletedAt`, tombstone), no un borrado físico, para que la
// sincronización pueda comunicar la baja; volver a añadirla reactiva la MISMA
// fila (unique userId+taskId).
model MyDayTask {
  id      String   @id @default(uuid()) @db.Char(36)
  userId  String   @db.Char(36)
  taskId  String   @db.Char(36)
  addedAt DateTime @default(now())
  // Para sincronizar: quitar de Mi día es un soft delete (tombstone), no un
  // borrado físico, y `updatedAt` permite pedir "qué cambió desde X". Toda
  // lectura filtra deletedAt: null. Mi día sigue sin noción de día en el
  // servidor (decisión del producto): `addedAt` es el único dato temporal.
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Un mismo usuario no puede marcar la misma tarea dos veces — el endpoint
  // de "agregar a mi día" crea la fila o reactiva la existente (deletedAt) sobre
  // esta combinación. Este unique ya cubre "todas las MyDayTask de este
  // usuario" como prefijo izquierdo, sin falta de un índice aparte por userId.
  @@unique([userId, taskId])
  @@index([userId, updatedAt])
  @@map("my_day_tasks")
}

// Paso/checklist dentro de una Task — se puede marcar completado
// independientemente de en qué columna esté la tarea (ej. columna
// "Terminado"). Tiene `deletedAt` (tombstone) para que la sincronización pueda
// comunicar el borrado a otros dispositivos; toda lectura filtra
// deletedAt: null. También desaparece si la Task dueña queda soft-deleted.
model Subtask {
  id         String    @id @default(uuid()) @db.Char(36)
  taskId     String    @db.Char(36)
  assigneeId String?   @db.Char(36)
  title      String    @db.VarChar(200)
  dueAt      DateTime?
  completed  Boolean   @default(false)
  position   Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Mismo criterio que Task.assignee: si se borra el usuario, la subtarea
  // sobrevive sin asignar.
  assignee User? @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([taskId, position])
  @@index([assigneeId])
  @@index([updatedAt])
  @@map("subtasks")
}

model Reminder {
  id        String         @id @default(uuid()) @db.Char(36)
  taskId    String         @db.Char(36)
  remindAt  DateTime
  status    ReminderStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  // Para la sincronización. Cancelar un recordatorio no borra la fila (pasa a
  // DISMISSED), así que ese estado ya hace de "borrado lógico" y `updatedAt`
  // basta para comunicarlo; no hace falta `deletedAt`.
  updatedAt DateTime       @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Índice pensado exactamente para la query del worker:
  // WHERE status = 'PENDING' AND remindAt <= NOW()
  @@index([status, remindAt])
  @@index([updatedAt])
  @@map("reminders")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  endpoint  String   @unique @db.VarChar(500)
  p256dhKey String   @db.VarChar(255)
  authKey   String   @db.VarChar(255)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @db.Char(36)
  action    String   @db.VarChar(100) // ej. "auth.login", "workspace.role_changed", "board.deleted"
  metadata  Json?
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  // SetNull en vez de Cascade: si se borra la cuenta, el registro de auditoría
  // permanece (útil legal y operativamente) pero sin vincular a un usuario ya inexistente.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Planes y suscripciones
//
// Regla de diseño central: NINGÚN límite ni feature de un plan se hardcodea
// en el código de la aplicación (nada de "if (plan === 'FREE') maxWorkspaces = 3").
// Todo vive en `PlanEntitlement` como pares clave/valor. Agregar un plan nuevo,
// o cambiar un límite existente, es una operación de datos — no requiere
// desplegar código ni migrar el schema. Solo introducir una clave *nueva* que
// el código todavía no entiende requiere trabajo de desarrollo; cambiar el
// valor de una clave existente para un plan, no.
//
// Ver docs/08-planes-suscripciones.md para el catálogo completo de claves,
// los valores iniciales de cada plan, y la política de periodo de gracia al
// bajar de plan.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

model Plan {
  id                String   @id @default(uuid()) @db.Char(36)
  // Identificador estable usado por el código para referirse a un plan conocido
  // (ej. asignar FREE en el registro). String, no enum — agregar un plan nuevo
  // no debe requerir una migración de schema.
  code              String   @unique @db.VarChar(30)
  name              String   @db.VarChar(100)
  description       String?  @db.VarChar(300)
  // null = sin precio fijo listado (plan Business, negociado por caso).
  priceMonthlyCents Int?
  isCustomPricing   Boolean  @default(false)
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  entitlements          PlanEntitlement[]
  subscriptionsCurrent  Subscription[]    @relation("CurrentPlan")
  subscriptionsPrevious Subscription[]    @relation("PreviousPlan")

  @@map("plans")
}

model PlanEntitlement {
  id     String @id @default(uuid()) @db.Char(36)
  planId String @db.Char(36)
  // Clave namespaced, ej. "storage.personal.enabled", "workspaces.owned.max".
  key    String @db.VarChar(100)
  // Siempre texto: "true"/"false" para flags, un entero como string para
  // límites numéricos (incluye MB de storage, ver docs/08-planes-suscripciones.md),
  // o el valor sentinela "unlimited". El significado de cada clave está
  // documentado en docs/08-planes-suscripciones.md, no en el tipo de columna.
  value  String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("plan_entitlements")
}

model Subscription {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @unique @db.Char(36)
  planId String @db.Char(36)

  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  canceledAt       DateTime?

  // Periodo de gracia de 24h tras una baja de plan: mientras
  // `downgradeGraceEndsAt` sea una fecha futura, los entitlements efectivos
  // se resuelven contra `previousPlanId` (el plan más generoso), no contra
  // `planId`. Al vencer, un proceso del worker limpia ambos campos y desde
  // ahí se aplican los límites del plan nuevo — sin borrar ni ocultar nada
  // que el usuario ya tuviera creado, solo bloqueando acciones nuevas que
  // excedan el límite.
  previousPlanId       String?   @db.Char(36)
  downgradeGraceEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, no Cascade: no debe poder borrarse un Plan que todavía tiene
  // suscripciones activas apuntándole — hay que migrar a esos usuarios primero.
  plan         Plan  @relation("CurrentPlan", fields: [planId], references: [id], onDelete: Restrict)
  previousPlan Plan? @relation("PreviousPlan", fields: [previousPlanId], references: [id], onDelete: SetNull)

  overrides SubscriptionEntitlementOverride[]

  @@index([planId])
  @@index([downgradeGraceEndsAt])
  @@map("subscriptions")
}

model SubscriptionEntitlementOverride {
  id             String  @id @default(uuid()) @db.Char(36)
  subscriptionId String  @db.Char(36)
  key            String  @db.VarChar(100)
  value          String  @db.VarChar(100)
  // Por qué existe este override — obligatorio en la práctica para cuentas
  // Business, donde todo el punto es la personalización caso por caso.
  note           String? @db.VarChar(300)

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, key])
  @@map("subscription_entitlement_overrides")
}

// Mutaciones de POST /sync/push ya procesadas. Es lo que hace idempotente el
// reenvío: el mismo (userId, clientMutationId) devuelve el resultado guardado
// sin ejecutar nada. Se conserva ≥ 30 días y se purga de forma perezosa desde
// el propio push. Nunca guarda el cuerpo de la mutación, solo el veredicto.
model SyncMutation {
  id               String             @id @default(uuid()) @db.Char(36)
  userId           String             @db.Char(36)
  clientMutationId String             @db.Char(36)
  status           SyncMutationStatus
  resultJson       Json
  createdAt        DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientMutationId])
  @@index([createdAt])
  @@map("sync_mutations")
}
